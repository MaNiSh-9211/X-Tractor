{
  "builds": [
    {
      "src": "wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.9"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "ocr_project.settings",
    "SECRET_KEY": "django-insecure-new-key-for-ocr-project",
    "DEBUG": "False"
  },
  "buildCommand": "bash build.sh",
  "installCommand": "pip install -r requirements.txt"
} 